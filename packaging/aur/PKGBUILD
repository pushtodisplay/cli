# Maintainer: YOUR_AUR_USERNAME_HERE <you@example.com>
# Contributor: Goban Source, LLC <maintainers@gobansource.com>
#
# TODO(release): bump pkgver, tag upstream as cli-v<version>, and update sha256sums
# (generate with: curl -sL https://github.com/pushtodisplay/cli/archive/refs/tags/cli-v<v>.tar.gz | sha256sum)

pkgname=pushtodisplay
pkgver=0.1.14
pkgrel=1
pkgdesc="CLI and MCP server for Push To Display - send real-time updates to display boards from your terminal"
arch=('any')
url="https://pushtodisplay.com"
license=('MIT')
depends=('nodejs')
# note: npm ships bundled with Arch's nodejs package, so no makedepends needed
source=("$pkgname-$pkgver.tar.gz::https://github.com/pushtodisplay/cli/archive/refs/tags/cli-v$pkgver.tar.gz")
sha256sums=('80bc78246a1da1e37a845820e593f4b1a7c605d69cdc4610fd0ae734d17f7931')

build() {
  cd "$srcdir/cli-cli-v$pkgver"
  npm ci --no-audit --no-fund
  npm run build:prod
}

package() {
  cd "$srcdir/cli-cli-v$pkgver"
  # Pack the built dist/ (single-file ESM bundles incl. mcp-server.js) and
  # install with npm's own global layout: /usr/lib/node_modules/pushtodisplay
  # + /usr/bin/pushtodisplay shim. The package.json (type: module) travels
  # with it, so Node resolves the ESM bundles correctly at runtime.
  npm pack --silent
  npm install -g --prefix "$pkgdir/usr" "pushtodisplay-$pkgver.tgz"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
